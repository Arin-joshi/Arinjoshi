# Web3Forms Access Key (https://web3forms.com/) - used in browser FormData submission
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Telegram Bot Notifications (server-only, never exposed to browser)
# Option A: Set TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
# Option B: Or set full TELEGRAM_API_URL (https://api.telegram.org/bot<TOKEN>/sendMessage) + TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_API_URL=
